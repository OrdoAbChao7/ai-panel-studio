# ==============================================================================
# AI Panel Studio — Root Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root or backend directory.
# NEVER commit the actual '.env' containing sensitive credentials to Git!
#
# ZERO-NETWORK MOCK FALLBACK:
# If LLM_API_KEY is left empty, undefined, or set to "mock", the backend
# automatically switches to high-fidelity zero-network MockLLMClient.
# All capabilities (dynamic arbitration, streaming speech, consensus/divergence
# tracking, moderator synthesis) will function offline deterministically.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Server Settings
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=false
RELOAD=false
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. LLM Provider Configuration (OpenAI Compatible API)
# ------------------------------------------------------------------------------
# Leave LLM_API_KEY blank to automatically enable Mock Engine fallback mode.
# When configured, calls are forwarded to your OpenAI or compatible provider.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# 3. Offline Mock Engine Configuration
# ------------------------------------------------------------------------------
# Set to 'true' to force Mock mode even if LLM credentials are provided.
# If LLM_API_KEY is empty, Mock fallback is automatically engaged.
ENABLE_MOCK_FALLBACK=true
# Simulated streaming speed in characters per second (CPS) for SSE chunking
MOCK_STREAM_SPEED_CPS=25
# Default mock scenario index (1-5) when topic matches pre-built scenarios
MOCK_DEFAULT_SCENARIO=1
SPEECH_CHUNK_DELAY_MS=40

# ------------------------------------------------------------------------------
# 4. Debate Engine & Arbitration Hyperparameters
# ------------------------------------------------------------------------------
DEFAULT_MAX_ROUNDS=6
DEFAULT_PARTICIPANT_COUNT=4
ROUND_TIMEOUT_SECONDS=180
# Consecutive turn cooldown turns (1 means cannot speak twice consecutively)
SPEAKER_COOLDOWN_TURNS=1

# Arbitration Formula Weights: S_i = 0.20*U + 0.25*C + 0.15*T + 0.15*E + 0.10*N + 0.15*F
ARBITRATOR_WEIGHT_URGENCY=0.20
ARBITRATOR_WEIGHT_CONFLICT=0.25
ARBITRATOR_WEIGHT_TOPICAL=0.15
ARBITRATOR_WEIGHT_EVIDENCE=0.15
ARBITRATOR_WEIGHT_NOVELTY=0.10
ARBITRATOR_WEIGHT_FAIRNESS=0.15

# ------------------------------------------------------------------------------
# 5. Database & Async Persistence Settings
# ------------------------------------------------------------------------------
# SQLite with aiosqlite for asynchronous DB access
DATABASE_URL=sqlite+aiosqlite:///./ai_panel_studio.db
SQL_ECHO=false

# ------------------------------------------------------------------------------
# 6. CORS & Frontend Client Settings
# ------------------------------------------------------------------------------
# Comma-separated list or JSON array of allowed origins
CORS_ORIGINS=["http://localhost:5174", "http://127.0.0.1:5174", "http://localhost:3000"]
